{
  "name": "enj",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "ENJ social platform - monorepo (apps/api, apps/web)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm install --include=dev && npm run build --workspace=api",
    "release": "npm run db:migrate --workspace=api",
    "start": "npm run start --workspace=api",
    "dev": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "dev:down": "docker compose down"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true
  }
}
