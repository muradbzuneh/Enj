{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://enj-fd0ec6a0ffca.herokuapp.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://enj-fd0ec6a0ffca.herokuapp.com/uploads/:path*"
    },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
